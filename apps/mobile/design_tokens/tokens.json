{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "NaviWealth design tokens. Source of truth for both Figma (via Tokens Studio import) and Flutter (via lib/design_system/tokens/*.dart). Keep file paths and values in sync — see apps/mobile/design_tokens/README.md.",
  "color": {
    "brand": {
      "50":  { "$value": "#EFF5FF", "$type": "color" },
      "100": { "$value": "#DBE8FE", "$type": "color" },
      "200": { "$value": "#BFD5FD", "$type": "color" },
      "300": { "$value": "#93B7FB", "$type": "color" },
      "400": { "$value": "#608FF6", "$type": "color" },
      "500": { "$value": "#1F6FEB", "$type": "color", "$description": "Primary seed" },
      "600": { "$value": "#1758C2", "$type": "color" },
      "700": { "$value": "#14479C", "$type": "color" },
      "800": { "$value": "#103A7E", "$type": "color" },
      "900": { "$value": "#0B2A5C", "$type": "color" }
    },
    "neutral": {
      "0":    { "$value": "#FFFFFF", "$type": "color" },
      "50":   { "$value": "#F7F8FA", "$type": "color" },
      "100":  { "$value": "#EFF1F4", "$type": "color" },
      "200":  { "$value": "#E2E5EA", "$type": "color" },
      "300":  { "$value": "#CBD0D7", "$type": "color" },
      "400":  { "$value": "#9AA1AC", "$type": "color" },
      "500":  { "$value": "#6B7280", "$type": "color" },
      "600":  { "$value": "#4B5563", "$type": "color" },
      "700":  { "$value": "#374151", "$type": "color" },
      "800":  { "$value": "#1F2937", "$type": "color" },
      "900":  { "$value": "#111827", "$type": "color" },
      "950":  { "$value": "#0B1220", "$type": "color" },
      "1000": { "$value": "#000000", "$type": "color" }
    },
    "accent": {
      "green": {
        "50":  { "$value": "#E8F7EE", "$type": "color" },
        "100": { "$value": "#C8EBD3", "$type": "color" },
        "300": { "$value": "#5CC788", "$type": "color" },
        "500": { "$value": "#16A34A", "$type": "color" },
        "600": { "$value": "#118A3D", "$type": "color" },
        "700": { "$value": "#0E6E32", "$type": "color" },
        "900": { "$value": "#064220", "$type": "color" }
      },
      "red": {
        "50":  { "$value": "#FDECEC", "$type": "color" },
        "100": { "$value": "#FAD0D0", "$type": "color" },
        "300": { "$value": "#EB7373", "$type": "color" },
        "500": { "$value": "#DC2626", "$type": "color" },
        "600": { "$value": "#B81D1D", "$type": "color" },
        "700": { "$value": "#8E1717", "$type": "color" },
        "900": { "$value": "#560B0B", "$type": "color" }
      },
      "amber": {
        "50":  { "$value": "#FEF6E5", "$type": "color" },
        "100": { "$value": "#FCE7B0", "$type": "color" },
        "500": { "$value": "#D97706", "$type": "color" },
        "700": { "$value": "#8E4E03", "$type": "color" }
      },
      "cyan": {
        "50":  { "$value": "#E6F4FB", "$type": "color" },
        "100": { "$value": "#C2E2F4", "$type": "color" },
        "500": { "$value": "#0891B2", "$type": "color" },
        "700": { "$value": "#075E73", "$type": "color" }
      },
      "colorblindBlue":   { "$value": "#2271B3", "$type": "color" },
      "colorblindOrange": { "$value": "#E69F00", "$type": "color" }
    },
    "semantic": {
      "light": {
        "success":            { "$value": "{color.accent.green.600}", "$type": "color" },
        "successContainer":   { "$value": "{color.accent.green.50}",  "$type": "color" },
        "warning":            { "$value": "{color.accent.amber.500}", "$type": "color" },
        "warningContainer":   { "$value": "{color.accent.amber.50}",  "$type": "color" },
        "danger":             { "$value": "{color.accent.red.600}",   "$type": "color" },
        "dangerContainer":    { "$value": "{color.accent.red.50}",    "$type": "color" },
        "info":               { "$value": "{color.accent.cyan.500}",  "$type": "color" },
        "infoContainer":      { "$value": "{color.accent.cyan.50}",   "$type": "color" },
        "divider":            { "$value": "{color.neutral.200}",      "$type": "color" },
        "scrim":              { "$value": "#00000066",                "$type": "color" }
      },
      "dark": {
        "success":            { "$value": "{color.accent.green.300}", "$type": "color" },
        "successContainer":   { "$value": "#0F3D22",                  "$type": "color" },
        "warning":            { "$value": "#F5B544",                  "$type": "color" },
        "warningContainer":   { "$value": "#3D2A05",                  "$type": "color" },
        "danger":             { "$value": "{color.accent.red.300}",   "$type": "color" },
        "dangerContainer":    { "$value": "#3F1010",                  "$type": "color" },
        "info":               { "$value": "#67D6F0",                  "$type": "color" },
        "infoContainer":      { "$value": "#06303C",                  "$type": "color" },
        "divider":            { "$value": "#26303D",                  "$type": "color" },
        "scrim":              { "$value": "#00000099",                "$type": "color" }
      }
    },
    "market": {
      "$description": "Direction-sensitive colors. The 'cn' set is the default; 'intl' swaps red/green; 'colorblind' uses the Wong palette.",
      "cn": {
        "light": {
          "up":   { "$value": "{color.accent.red.600}",   "$type": "color" },
          "down": { "$value": "{color.accent.green.600}", "$type": "color" },
          "flat": { "$value": "{color.neutral.500}",      "$type": "color" }
        },
        "dark": {
          "up":   { "$value": "{color.accent.red.300}",   "$type": "color" },
          "down": { "$value": "{color.accent.green.300}", "$type": "color" },
          "flat": { "$value": "{color.neutral.400}",      "$type": "color" }
        }
      },
      "intl": {
        "light": {
          "up":   { "$value": "{color.accent.green.600}", "$type": "color" },
          "down": { "$value": "{color.accent.red.600}",   "$type": "color" },
          "flat": { "$value": "{color.neutral.500}",      "$type": "color" }
        },
        "dark": {
          "up":   { "$value": "{color.accent.green.300}", "$type": "color" },
          "down": { "$value": "{color.accent.red.300}",   "$type": "color" },
          "flat": { "$value": "{color.neutral.400}",      "$type": "color" }
        }
      },
      "colorblind": {
        "light": {
          "up":   { "$value": "{color.accent.colorblindBlue}",   "$type": "color" },
          "down": { "$value": "{color.accent.colorblindOrange}", "$type": "color" },
          "flat": { "$value": "{color.neutral.500}",             "$type": "color" }
        },
        "dark": {
          "up":   { "$value": "#6FAEE0", "$type": "color" },
          "down": { "$value": "#F6C863", "$type": "color" },
          "flat": { "$value": "{color.neutral.400}", "$type": "color" }
        }
      }
    }
  },
  "spacing": {
    "s0":  { "$value": "0",  "$type": "dimension" },
    "s2":  { "$value": "2",  "$type": "dimension" },
    "s4":  { "$value": "4",  "$type": "dimension" },
    "s6":  { "$value": "6",  "$type": "dimension" },
    "s8":  { "$value": "8",  "$type": "dimension" },
    "s12": { "$value": "12", "$type": "dimension" },
    "s16": { "$value": "16", "$type": "dimension" },
    "s20": { "$value": "20", "$type": "dimension" },
    "s24": { "$value": "24", "$type": "dimension" },
    "s32": { "$value": "32", "$type": "dimension" },
    "s40": { "$value": "40", "$type": "dimension" },
    "s48": { "$value": "48", "$type": "dimension" },
    "s56": { "$value": "56", "$type": "dimension" },
    "s64": { "$value": "64", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0",    "$type": "dimension" },
    "xs":   { "$value": "4",    "$type": "dimension" },
    "sm":   { "$value": "8",    "$type": "dimension" },
    "md":   { "$value": "12",   "$type": "dimension" },
    "lg":   { "$value": "16",   "$type": "dimension" },
    "xl":   { "$value": "20",   "$type": "dimension" },
    "xxl":  { "$value": "28",   "$type": "dimension" },
    "full": { "$value": "9999", "$type": "dimension" }
  },
  "typography": {
    "displayLarge":   { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "40", "fontWeight": "700", "lineHeight": "1.1",  "letterSpacing": "-0.5" } },
    "displayMedium":  { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "32", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.25" } },
    "displaySmall":   { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "26", "fontWeight": "600", "lineHeight": "1.2",  "letterSpacing": "0" } },
    "headlineLarge":  { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "24", "fontWeight": "600", "lineHeight": "1.25", "letterSpacing": "0" } },
    "headlineMedium": { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "20", "fontWeight": "600", "lineHeight": "1.3",  "letterSpacing": "0" } },
    "headlineSmall":  { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "18", "fontWeight": "600", "lineHeight": "1.35", "letterSpacing": "0" } },
    "titleLarge":     { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "16", "fontWeight": "600", "lineHeight": "1.4",  "letterSpacing": "0" } },
    "titleMedium":    { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "14", "fontWeight": "600", "lineHeight": "1.4",  "letterSpacing": "0" } },
    "titleSmall":     { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "13", "fontWeight": "600", "lineHeight": "1.4",  "letterSpacing": "0" } },
    "bodyLarge":      { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "16", "fontWeight": "400", "lineHeight": "1.5",  "letterSpacing": "0" } },
    "bodyMedium":     { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "14", "fontWeight": "400", "lineHeight": "1.5",  "letterSpacing": "0" } },
    "bodySmall":      { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "13", "fontWeight": "400", "lineHeight": "1.45", "letterSpacing": "0" } },
    "labelLarge":     { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "14", "fontWeight": "600", "lineHeight": "1.3",  "letterSpacing": "0.1" } },
    "labelMedium":    { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "12", "fontWeight": "600", "lineHeight": "1.3",  "letterSpacing": "0.4" } },
    "labelSmall":     { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "11", "fontWeight": "600", "lineHeight": "1.3",  "letterSpacing": "0.5" } },
    "numericDisplay": { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "32", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.25", "fontFeatures": "tnum,lnum" } },
    "numericTitle":   { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "20", "fontWeight": "600", "lineHeight": "1.3",  "letterSpacing": "0",     "fontFeatures": "tnum,lnum" } },
    "numericBody":    { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "14", "fontWeight": "500", "lineHeight": "1.4",  "letterSpacing": "0",     "fontFeatures": "tnum,lnum" } },
    "numericCaption": { "$type": "typography", "$value": { "fontFamily": "system-sans", "fontSize": "12", "fontWeight": "500", "lineHeight": "1.3",  "letterSpacing": "0",     "fontFeatures": "tnum,lnum" } }
  },
  "shadow": {
    "light": {
      "level1": { "$type": "shadow", "$value": [
        { "color": "#1118270A", "offsetX": "0", "offsetY": "1",  "blur": "1",  "spread": "0" },
        { "color": "#1118270F", "offsetX": "0", "offsetY": "1",  "blur": "2",  "spread": "0" }
      ]},
      "level2": { "$type": "shadow", "$value": [
        { "color": "#1118270D", "offsetX": "0", "offsetY": "1",  "blur": "2",  "spread": "0" },
        { "color": "#11182712", "offsetX": "0", "offsetY": "3",  "blur": "6",  "spread": "0" }
      ]},
      "level3": { "$type": "shadow", "$value": [
        { "color": "#1118270F", "offsetX": "0", "offsetY": "2",  "blur": "4",  "spread": "0" },
        { "color": "#1118271A", "offsetX": "0", "offsetY": "6",  "blur": "12", "spread": "0" }
      ]},
      "level4": { "$type": "shadow", "$value": [
        { "color": "#11182714", "offsetX": "0", "offsetY": "4",  "blur": "6",  "spread": "0" },
        { "color": "#1118272A", "offsetX": "0", "offsetY": "12", "blur": "24", "spread": "0" }
      ]}
    },
    "dark": {
      "level1": { "$type": "shadow", "$value": [
        { "color": "#0000004D", "offsetX": "0", "offsetY": "1",  "blur": "2",  "spread": "0" }
      ]},
      "level2": { "$type": "shadow", "$value": [
        { "color": "#00000066", "offsetX": "0", "offsetY": "3",  "blur": "6",  "spread": "0" }
      ]},
      "level3": { "$type": "shadow", "$value": [
        { "color": "#00000080", "offsetX": "0", "offsetY": "6",  "blur": "12", "spread": "0" }
      ]},
      "level4": { "$type": "shadow", "$value": [
        { "color": "#00000099", "offsetX": "0", "offsetY": "12", "blur": "24", "spread": "0" }
      ]}
    }
  },
  "motion": {
    "duration": {
      "fast":   { "$value": "120ms", "$type": "duration" },
      "medium": { "$value": "220ms", "$type": "duration" },
      "slow":   { "$value": "360ms", "$type": "duration" },
      "ticker": { "$value": "800ms", "$type": "duration" }
    },
    "easing": {
      "emphasized":           { "$value": "cubic-bezier(0.2, 0, 0, 1)",        "$type": "cubicBezier" },
      "emphasizedDecelerate": { "$value": "cubic-bezier(0.05, 0.7, 0.1, 1)",   "$type": "cubicBezier" },
      "standard":             { "$value": "cubic-bezier(0.2, 0, 0, 1)",        "$type": "cubicBezier" },
      "standardDecelerate":   { "$value": "cubic-bezier(0, 0, 0, 1)",          "$type": "cubicBezier" },
      "standardAccelerate":   { "$value": "cubic-bezier(0.3, 0, 1, 1)",        "$type": "cubicBezier" }
    }
  },
  "breakpoint": {
    "mobile":  { "$value": "600",  "$type": "dimension" },
    "desktop": { "$value": "1240", "$type": "dimension" }
  }
}
