{
  "name": "NaviWealth",
  "id": "com.naviwealth.app",
  "version": "0.18.3",
  "build": 32,
  "appearance": "system",
  "theme": "theme.json",
  "rust": ".",
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "statusBar": true,
    "clipboard": true,
    "picker": true,
    "speech": true,
    "notifications": true,
    "audio": true,
    "openUrl": true,
    "share": true,
    "windows": true,
    "host": [
      "ble.status",
      "ble.scan.start",
      "ble.scan.stop",
      "ble.connect",
      "ble.disconnect",
      "ble.write"
    ],
    "fs": {
      "read": [
        "${dataDir}",
        "${pluginDir}"
      ]
    }
  }
}
