      "html": "<section class=\"ds-activity\"><p>2026-11-11</p><div class=\"ds-activity-group\"><button aria-label=\"午餐，现金，-68.50 CNY\"><span class=\"ds-activity-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 20V4m-6 6 6-6 6 6\"/></svg></span><span class=\"ds-activity-title\">午餐<small>现金</small></span><span class=\"ds-activity-amount\">−68.50<small>CNY</small></span></button><button aria-label=\"买入 · CoreStock，结算 CoreBank · 持仓 CoreBroker，-101.00 CNY\"><span class=\"ds-activity-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 8V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-2\"/><path d=\"M21 8h-7v8h7zM16 12h1\"/></svg></span><span class=\"ds-activity-title\">买入 · CoreStock<small>结算 CoreBank · 持仓 CoreBroker</small></span><span class=\"ds-activity-amount\">-101.00<small>CNY</small></span></button></div></section>",
      "css": ".ds-activity{font:14px/20px system-ui,sans-serif;color:#162D35}.ds-activity>p{margin:0 0 8px;color:#526A70;font-weight:500}.ds-activity-group{background:#FFFFFF;border-radius:16px}.ds-activity button{width:100%;display:flex;align-items:center;gap:12px;min-height:64px;padding:12px 8px;border:0;background:transparent;color:inherit;text-align:left}.ds-activity-icon{width:30px;height:30px;flex-shrink:0;display:grid;place-items:center;background:#E8F0EE;border-radius:12px}.ds-activity-icon svg{width:22px;height:22px}.ds-activity-title{flex:1;min-width:0;font-size:15px;font-weight:500}.ds-activity small{display:block;color:#526A70;font-weight:400}.ds-activity-title small{font-size:14px}.ds-activity-amount{font-size:16px;font-weight:500;text-align:right;font-variant-numeric:tabular-nums}.ds-activity-amount small{font-size:12px;line-height:16px}.ds-activity button:hover{background:#E8F0EE}.ds-activity button:focus-visible{outline:2px solid #168F88;outline-offset:-2px}"
