  "narrative": {
    "northStar": "Contemporary Atlas Precision",
    "overview": "Marine, mist, and restrained teal-family tones frame a precise native financial workspace. Compact system typography, quiet dated lists, thin line icons, and aligned tabular amounts make recorded facts easy to inspect. The recurring signature is an acknowledgment beside the fact an action changed.\n\nThis system is scoped to the Rust/nsh client in `apps/client`. `theme.json`, `src/ui.rs`, and `src/finance_ui.rs` own the implemented roles and shared primitives; repository-root design artifacts describe Flutter separately. Product terminology, explicit financial meaning, native navigation, and readable scaled text take priority over decorative expression. Surface composition belongs in `.impeccable/surfaces/apps-client-finance-core.md`.",
    "keyCharacteristics": [
      "Marine actions and mist surfaces, with paired light and dark roles.",
      "Compact flat rows, explicit currencies, and exact tabular financial values.",
      "Native controls, guarded drafts, and in-place changed-fact receipts."
    ],
    "rules": [
      {
        "name": "The Currency Rule",
        "body": "Currency, signs, labels, and unavailable states carry meaning; color is supplementary.",
        "section": "colors"
      },
      {
        "name": "The Exact Amount Rule",
        "body": "Display monetary values as exact Decimal text with tabular digits, preserving small nonzero values and at least two fractional places.",
        "section": "typography"
      },
      {
        "name": "The Account Role Rule",
        "body": "Name investment operations and holding/settlement roles explicitly; reserve arrows for actual account transfers.",
        "section": "components"
      },
      {
        "name": "The Local Receipt Rule",
        "body": "A changed-fact receipt stays beside the affected financial facts until the next task; a bottom notice is supplementary.",
        "section": "components"
      },
      {
        "name": "The Evidence Rule",
        "body": "Plot recorded observations and break the line at missing evidence; insufficient history becomes a dated textual observation.",
        "section": "components"
      }
    ],
    "dos": [
      "Do pair each surface with its own appearance's foreground role.",
      "Do keep amounts aligned and distinguish quantity, cost, price, cash, and gain.",
      "Do reuse native shared fields, buttons, sheets, icons, and guarded navigation.",
      "Do retain invalid drafts and give the user a concrete correction or retry.",
      "Do show changed facts and missing valuation evidence in native text.",
      "Do preserve complete operation, account-role, amount, and currency semantics in row accessibility labels."
    ],
    "donts": [
      "Don't combine currencies without recorded conversion evidence.",
      "Don't add a card around each row inside an existing group.",
      "Don't rely on color alone for financial direction or destructive intent.",
      "Don't use a transfer arrow for an investment's holding and settlement relationship.",
      "Don't fabricate chart history or connect a line across missing prices or exchange rates.",
      "Don't add decorative atlas graphics, raster ornament, or marketing hierarchy to the task workspace."
    ]
  }
}
