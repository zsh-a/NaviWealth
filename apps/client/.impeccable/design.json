  "narrative": {
    "northStar": "The Porcelain Ledger",
    "overview": "A quiet porcelain-and-graphite workspace for inspecting money and recording daily activity. Iris identifies the next useful action; exact amounts and dated rows carry the hierarchy. The Rust client extends the established 澄白 identity with native controls and restrained tonal grouping.\n\nThis system is scoped to `apps/client`. `theme.json` and the Rust implementation are the source of truth; the repository-root Flutter design system remains separate. This records daily-finance patterns, not release or platform acceptance.",
    "keyCharacteristics": [
      "Flat dated activity with right-aligned, explicit-currency amounts.",
      "Clear capture actions, grouped fields, and restrained iris emphasis.",
      "Native safe-area handling and guarded changes."
    ],
    "rules": [
      {
        "name": "The Currency Rule",
        "body": "Currency labels and signs carry financial meaning; color is supplementary.",
        "section": "colors"
      },
      {
        "name": "The Exact Amount Rule",
        "body": "Use tabular digits for displayed monetary values and exact Decimal text; never round a small nonzero amount to zero for presentation.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep currencies explicit and totals separate by currency.",
      "Do use exact Decimal text with at least two fractional places; retain smaller nonzero values.",
      "Do use shared buttons, fields, sheets, icons, and theme roles.",
      "Do preserve dirty drafts and show errors beside the operation that failed."
    ],
    "donts": [
      "Don't combine unlike currencies without a real conversion.",
      "Don't put a card around each row inside an already grouped surface.",
      "Don't rely on color alone for income, expense, transfer, or destructive intent.",
      "Don't turn the daily workspace into a marketing page."
    ]
  }
}
