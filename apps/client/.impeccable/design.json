    {
      "name": "Changed budget fact",
      "kind": "custom",
      "refersTo": "changed-fact",
      "description": "Synthetic affected value and persistent receipt; the secondary wash illustrates the implemented fade, with a static reduced-motion highlight.",
      "html": "<div class=\"ds-fact\"><div class=\"ds-fact-wash\"></div><div class=\"ds-fact-content\"><span>餐饮 · CNY</span><strong>已用 68.50 / 1500.00</strong><small>预算已保存，额度与结余已更新</small></div></div>",
      "css": ".ds-fact{position:relative;color:#162D35;font:14px/20px system-ui,sans-serif}.ds-fact-wash{position:absolute;inset:0;background:#DFEEEB;border-radius:12px;opacity:0;pointer-events:none;animation:ds-fact-fade 1800ms cubic-bezier(.16,1,.3,1)}.ds-fact-content{position:relative;display:grid;gap:4px}.ds-fact strong{font-weight:500;font-variant-numeric:tabular-nums}.ds-fact small{font:12px/16px system-ui,sans-serif;color:#153D52}@keyframes ds-fact-fade{from{opacity:.75}to{opacity:0}}@media(prefers-reduced-motion:reduce){.ds-fact-wash{animation:none;opacity:.75}}"
    },
