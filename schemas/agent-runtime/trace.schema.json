{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naviwealth.local/schemas/agent-runtime/trace.schema.json",
  "title": "AgentTrace",
  "type": "object",
  "required": [
    "protocol_version",
    "runtime_version",
    "run_id",
    "agent_id",
    "agent_version",
    "started_at",
    "finished_at",
    "events"
  ],
  "properties": {
    "protocol_version": { "const": "agent.v1" },
    "runtime_version": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "agent_version": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "input": { "type": "object", "default": {} },
    "output": { "type": "object", "default": {} },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "occurred_at"],
        "properties": {
          "kind": { "type": "string" },
          "occurred_at": { "type": "string", "format": "date-time" },
          "payload": { "type": "object", "default": {} }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": { "const": "agent_runtime_step" }
              },
              "required": ["kind"]
            },
            "then": {
              "required": ["payload"],
              "properties": {
                "payload": {
                  "type": "object",
                  "required": [
                    "run_id",
                    "agent_id",
                    "status",
                    "step_index",
                    "tool_name",
                    "run_state"
                  ],
                  "properties": {
                    "run_id": { "type": "string", "minLength": 1 },
                    "agent_id": { "type": "string", "minLength": 1 },
                    "status": {
                      "enum": [
                        "tool_call_requested",
                        "completed",
                        "failed",
                        "cancelled",
                        "policy_denied",
                        "closed_early",
                        "timed_out"
                      ]
                    },
                    "step_index": { "type": "integer", "minimum": 0 },
                    "tool_name": { "type": ["string", "null"] },
                    "run_state": {
                      "type": "object",
                      "required": [
                        "status",
                        "step_index",
                        "remaining_tool_count",
                        "tool_result_count",
                        "terminal_reason"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "tool_call_requested",
                            "completed",
                            "failed",
                            "cancelled",
                            "policy_denied",
                            "closed_early",
                            "timed_out"
                          ]
                        },
                        "step_index": { "type": ["integer", "null"], "minimum": 0 },
                        "remaining_tool_count": { "type": "integer", "minimum": 0 },
                        "tool_result_count": { "type": "integer", "minimum": 0 },
                        "terminal_reason": {
                          "enum": [
                            "done",
                            "stream_error",
                            "user_cancel",
                            "policy_denied",
                            "closed_early",
                            null
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
