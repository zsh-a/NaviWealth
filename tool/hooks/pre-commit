#!/usr/bin/env bash
# NaviWealth pre-commit: dart format + flutter analyze on staged Dart files.
# Installed by tool/install-hooks.sh.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
mobile_dir="$repo_root/apps/mobile"

# Collect staged .dart files inside apps/mobile/, excluding generated output.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^apps/mobile/.*\.dart$' \
  | grep -Ev '\.(g|freezed)\.dart$' || true)

if [ ${#staged[@]} -eq 0 ]; then
  exit 0
fi

if ! command -v flutter >/dev/null 2>&1; then
  echo "pre-commit: flutter not found on PATH; skipping checks." >&2
  exit 0
fi

echo "pre-commit: dart format (${#staged[@]} file(s))..."
dart_paths=()
for f in "${staged[@]}"; do
  dart_paths+=("$repo_root/$f")
done
dart format --set-exit-if-changed "${dart_paths[@]}"

echo "pre-commit: flutter analyze..."
(cd "$mobile_dir" && flutter analyze --fatal-infos)

# i18n guard — fail fast on new CN string literals so reviewers don't have
# to wait on CI to catch the regression. The script is the same one
# mobile.yml runs, so a green pre-commit means a green job for this check.
echo "pre-commit: cn-literal-check..."
(cd "$mobile_dir" && dart tool/check_cn_literals.dart)
