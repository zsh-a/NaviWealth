{
  "scope": "Artifact-scoped quiet workspace browser proposal; user-selected strategy, not production/native authority",
  "mode": "Operate",
  "light": {
    "canvas": "#F8F8F8",
    "paper": "#FFFFFF",
    "ink": "#262626",
    "muted": "#656565",
    "line": "#E2E2E2",
    "soft": "#EFEFEF",
    "wash": "#EAEFF2",
    "action": "#2C2C2C",
    "onAction": "#FFFFFF",
    "focus": "#345E74",
    "link": "#345E74",
    "gain": "#356747",
    "error": "#AD3833",
    "warning": "#815728",
    "dataCash": "#8A8A8A",
    "dataInvestment": "#536978"
  },
  "dark": {
    "canvas": "#191919",
    "paper": "#232323",
    "ink": "#ECECEC",
    "muted": "#B0B0B0",
    "line": "#383838",
    "soft": "#2E2E2E",
    "wash": "#303A40",
    "action": "#E7E7E7",
    "onAction": "#252525",
    "focus": "#9BB5C9",
    "link": "#BACDD8",
    "gain": "#96B79F",
    "error": "#E9A39B",
    "warning": "#D3B287",
    "dataCash": "#808080",
    "dataInvestment": "#A4B4BF"
  },
  "type": {
    "family": "platform system sans; tabular financial figures",
    "page": 22,
    "section": 14,
    "rowTitle": 14,
    "rowAmount": 15,
    "summaryExpense": 29,
    "summaryIncome": 20,
    "netWorth": 32,
    "amountInput": 40,
    "units": "CSS px at 100%; not validated native dp/sp"
  },
  "geometry": {
    "pageInset": 22,
    "narrowInset": 18,
    "rowMinHeight": 68,
    "actionRadius": 10,
    "fieldRadius": 9,
    "sheetRadius": 18,
    "targetMin": 48,
    "captureVisibleHeight": 48,
    "captureHitHeight": 48,
    "categoryMinHeight": 48,
    "navMinHeight": 52,
    "workspaceHeight": 64,
    "categoryGap": 6,
    "categorySymbolSize": 17
  },
  "material": {
    "regions": "Top workspace and bottom navigation only",
    "blurCssPx": 20,
    "saturationPercent": 105,
    "tintAlpha": [
      0.96,
      0.88
    ],
    "editor": "opaque paper",
    "modalBackgroundChrome": "solid",
    "fallbacks": [
      "solid=1",
      "in-app setting",
      "prefers-reduced-transparency",
      "unsupported-backdrop-filter CSS rule"
    ],
    "fallbackEvidence": "solid query, in-app setting and emulated system preference tested; unsupported CSS branch not executed in unsupported browser"
  },
  "motion": {
    "pressMs": 120,
    "navigationMs": 200,
    "sheetEnterMs": 280,
    "sheetExitMs": 220,
    "commitMs": 1000,
    "exactSynchronousFinancialMutation": true,
    "moneyInterpolation": false,
    "loops": false,
    "reduced": "immediate state, static changed row, persistent receipt",
    "choiceMs": 120
  },
  "category": {
    "composition": "Independent choices; no shared track, white inset or shadow",
    "selected": "wash surface, ink label, steel-blue check replacing category icon",
    "unselected": "muted category icon and label",
    "feedback": "120ms icon/check opacity; aria-pressed and visible keyboard focus"
  }
}
